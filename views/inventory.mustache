<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{title}}</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Header -->
    <header>
        <h1>🎲 The Rolling Die</h1>
        <p>Your Local Board Game Store & Café</p>

        <nav>
            <a href="/">Home</a>
            <a href="/inventory" class="active">Browse Games</a>
            <a href="/manager/login">Manager Login</a>
        </nav>
    </header>

    <!-- Inventory -->
    <main class="inventory-container">

        <h2>Our Board Game Collection</h2>

        <p>
            Explore our collection of board games.
            Check prices and availability before visiting our store!
        </p>

        <!-- Search Bar -->
        <form action="/inventory" method="GET" class="search-form" role="search">

            <div class="search-input-wrapper">
                <span class="search-icon">🔍</span>
                <input
                    type="text"
                    name="search"
                    placeholder="Search by game title or category..."
                    value="{{searchTerm}}"
                    aria-label="Search board games"
                >
            </div>

            <div class="search-actions">
                <button type="submit" class="btn">
                    Search
                </button>

                {{#searchTerm}}
                <a href="/inventory" class="btn reset-btn" title="Clear search">
                    ✕ Clear
                </a>
                {{/searchTerm}}
                {{^searchTerm}}
                <a href="/inventory" class="btn reset-btn" title="Show all games">
                    Show All
                </a>
                {{/searchTerm}}
            </div>

        </form>

        {{#searchTerm}}
        <div class="search-feedback">
            <span>Showing results for "<strong>{{searchTerm}}</strong>"</span>
            <a href="/inventory" class="clear-search-link">Reset</a>
        </div>
        {{/searchTerm}}

        <!-- Inventory Table -->

        {{#hasGames}}

        <div class="inventory-table-wrapper">

            <table class="public-inventory-table">

                <thead>
                    <tr>
                        <th>Game Title</th>
                        <th>Category</th>
                        <th>Players</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Availability</th>
                    </tr>
                </thead>

                <tbody>

                    {{#games}}

                    <tr>

                        <td class="game-title">
                            🎲 {{title}}
                        </td>

                        <td>
                            {{category}}
                        </td>

                        <td>
                            {{players}}
                        </td>

                        <td class="game-price">
                            ${{formattedPrice}}
                        </td>

                        <td>
                            {{stock}}
                        </td>

                        <td>

                            {{#inStock}}
                            <span class="stock-badge in-stock">
                                ● In Stock
                            </span>
                            {{/inStock}}

                            {{#outOfStock}}
                            <span class="stock-badge out-stock">
                                ● Out of Stock
                            </span>
                            {{/outOfStock}}

                        </td>

                    </tr>

                    {{/games}}

                </tbody>

            </table>

        </div>

        {{/hasGames}}

        {{^hasGames}}

        <div class="no-results">
            <div class="no-results-icon">🎲</div>
            <h3>No games found</h3>
            <p>We couldn't find any games matching "{{searchTerm}}". Try checking your spelling or searching by category like Strategy, Party, or Family.</p>
            <a href="/inventory" class="btn reset-btn">
                Show All Games
            </a>
        </div>

        {{/hasGames}}

    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 The Rolling Die</p>
    </footer>

</body>

</html>