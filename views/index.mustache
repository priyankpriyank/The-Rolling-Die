<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{title}}</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <h1>🎲 The Rolling Die</h1>
        <p>Your Local Board Game Store & Café</p>
        <nav>
            <a href="/" class="active">Home</a>
            <a href="/inventory">Browse Games</a>
            <a href="/manager/login">Manager Login</a>
        </nav>
    </header>

    <main class="home-container">

        <h2>{{message}}</h2>

        <p>
            Discover exciting board games, check availability,
            and explore our collection.
        </p>

        <!-- Quick Search Bar -->
        <form action="/inventory" method="GET" class="search-form home-search" role="search">
            <div class="search-input-wrapper">
                <span class="search-icon">🔍</span>
                <input
                    type="text"
                    name="search"
                    placeholder="Search by title or category (e.g. Catan, Strategy)..."
                    aria-label="Search board games"
                >
            </div>
            <div class="search-actions">
                <button type="submit" class="btn">
                    Search
                </button>
            </div>
        </form>

        <div class="home-actions">
            <a href="/inventory" class="btn reset-btn">
                Browse Full Collection
            </a>
        </div>

    </main>

    <footer>
        <p>&copy; 2026 The Rolling Die</p>
    </footer>

</body>

</html>