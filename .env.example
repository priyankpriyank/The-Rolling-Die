# Server Configuration
PORT=3000

# Session Secret (random 32+ character string)
SESSION_SECRET=your_long_random_session_secret_key_here

# Discord Bot Credentials
# Obtain these from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_GUILD_ID=your_discord_server_guild_id_here

# Initial Manager Credentials (password must be at least 12 characters)
MANAGER_USERNAME=admin
MANAGER_PASSWORD=your_secure_manager_password_12chars
